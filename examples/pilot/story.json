      "id": "ep1",
      "title": "The Last Envelope",
      "draft_seconds": 45,
      "setup": "Mira comes for her certificates before leaving.",
      "turn": "Dev admits that her grant was approved and gives her the key.",
      "cliffhanger": "Mira has her choice back; will she leave without forgiving him?",
      "lines": [
        {
          "id": "ep1line1",
          "speaker": "mira",
          "text": "The bus leaves at six. I need my certificates.",
          "performance": "firm, avoiding an argument"
        },
        {
          "id": "ep1line2",
          "speaker": "mira",
          "text": "Why is my name on that envelope?",
          "performance": "quiet suspicion"
        },
        {
          "id": "ep1line3",
          "speaker": "dev",
          "text": "They approved it yesterday. I could not make myself tell you.",
          "performance": "ashamed, direct"
        },
        {
          "id": "ep1line4",
          "speaker": "mira",
          "text": "You let me think I failed. Give me the key.",
          "performance": "hurt, controlled"
        },
        {
          "id": "ep1line5",
          "speaker": "dev",
          "text": "I thought you would stay if you had no reason to go.",
          "performance": "fragile admission"
        },
        {
          "id": "ep1line6",
          "speaker": "mira",
          "text": "Ask me to stay. Do not take away the choice.",
          "performance": "quiet, refusing easy forgiveness"
        }
      ],
