  "characters": {
    "Anu": {
      "reference": "../refs/char_anu_rao.png",
      "wardrobe": "Mustard kurti, navy blazer ON, canvas tote. Same clothes as reference."
    },
    "Vikram": {
      "reference": "../refs/char_vikram_sethi.png",
      "wardrobe": "Same suit and glasses as reference."
    },
    "Priya": {
      "reference": "../refs/char_priya_nair.png",
      "wardrobe": "Same clothes as reference."
    },
    "Arjun": {
      "reference": "../refs/char_arjun_malhotra.png",
      "wardrobe": "Same dark casual shirt and lanyard as reference."
    }
  },
  "locations": {
    "lobby": "../refs/loc_lobby.png",
    "elevator": "../refs/loc_elevator.png",
    "floor": "../refs/loc_office_floor.png",
    "cabin": "../refs/loc_cabin.png",
    "stairwell": "../refs/loc_stairwell.png",
    "chai": "../refs/loc_chai_stall.png",
    "pantry": "../refs/loc_pantry.png",
    "corridor": "../refs/loc_office_floor.png"
